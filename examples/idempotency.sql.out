-- This file contains the sql queries plus their output, but we set the filetype to sql for better syntax highlighting
-- vim: set filetype=sql:

-- This is a fully working example script that shows how to use idempotency keys
--
-- Note that it uses `\gset` to store sql responses as variables. For example,
-- `\gset foo_` creates variables for each column in the response like
-- `foo_col1`, `foo_col2`, etc. These variables can then be used like
-- `:'foo1_col`.
-- The entire script can be passed to psql. If you are running postgres via the
-- pgledger docker compose, you can run this script with:
--
--   cat idempotency.sql | \
--     docker compose exec --no-TTY postgres psql -U pgledger --echo-all --no-psqlrc
--
-- Create a couple of accounts for testing
SELECT id FROM pgledger_create_account('account1', 'USD') \gset account1_
SELECT id FROM pgledger_create_account('account2', 'USD') \gset account2_
-- Create an idempotency_key (normally, you'll do this in application code)
SELECT uuidv4() AS idempotency_key \gset
SELECT :'idempotency_key';
               ?column?               
--------------------------------------
 7a1119e6-4f03-4643-a14e-2b086ff800df
(1 row)

-- Create a transfer using the idempotency_key
SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    10.00,
    idempotency_key => :'idempotency_key'
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |           event_at            | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+-------------------------------+----------
 pglt_01M64SK6HVE9R9JEP1H8P9317H | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |  10.00 | 2026-10-29 21:38:27.513189+00 | 2026-10-29 21:38:27.513189+00 | 
(1 row)

-- Another transfer with the same key will return the existing transfer
SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    10.00,
    idempotency_key => :'idempotency_key'
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |           event_at            | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+-------------------------------+----------
 pglt_01M64SK6HVE9R9JEP1H8P9317H | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |  10.00 | 2026-10-29 21:38:27.513189+00 | 2026-10-29 21:38:27.513189+00 | 
(1 row)

-- But if the arguments are different, it will give an error:
SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    99.00,
    idempotency_key => :'idempotency_key'
);
ERROR:  Idempotency key (7a1119e6-4f03-4643-a14e-2b086ff800df) was already used with a different request
CONTEXT:  PL/pgSQL function pgledger_create_transfers(transfer_request[],timestamp with time zone,jsonb,text) line 55 at RAISE
SQL statement "SELECT * FROM pgledger_create_transfers(
        transfer_requests => array[(from_account_id, to_account_id, amount)::TRANSFER_REQUEST],
        event_at => event_at,
        metadata => metadata,
        idempotency_key => idempotency_key
    )"
PL/pgSQL function pgledger_create_transfer(text,text,numeric,timestamp with time zone,jsonb,text) line 4 at RETURN QUERY
-- We can see that there's exactly one transfer for this idempotency_key
SELECT * FROM pgledger_idempotency_keys_view
WHERE idempotency_key = :'idempotency_key';
           idempotency_key            | request_index |           transfer_id           
--------------------------------------+---------------+---------------------------------
 7a1119e6-4f03-4643-a14e-2b086ff800df |             1 | pglt_01M64SK6HVE9R9JEP1H8P9317H
(1 row)

-- Idempotency also works for batches of transfers:
SELECT * FROM pgledger_create_transfers(
    event_at => '2026-10-25T12:45:54.123Z',
    idempotency_key => :'idempotency_key' || '-batch',
    transfer_requests => ARRAY[
        (:'account1_id', :'account2_id', '1.00'),
        (:'account1_id', :'account2_id', '2.00')
    ]::TRANSFER_REQUEST[]
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |          event_at          | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+----------------------------+----------
 pglt_01M64SK6HXE0QBMXV8RSS3RSRQ | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |   1.00 | 2026-10-29 21:38:27.516756+00 | 2026-10-25 12:45:54.123+00 | 
 pglt_01M64SK6HXEET9BRBS65X6161H | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |   2.00 | 2026-10-29 21:38:27.516756+00 | 2026-10-25 12:45:54.123+00 | 
(2 rows)

SELECT * FROM pgledger_create_transfers(
    event_at => '2026-10-25T12:45:54.123Z',
    idempotency_key => :'idempotency_key' || '-batch',
    transfer_requests => ARRAY[
        (:'account1_id', :'account2_id', '1.00'),
        (:'account1_id', :'account2_id', '2.00')
    ]::TRANSFER_REQUEST[]
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |          event_at          | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+----------------------------+----------
 pglt_01M64SK6HXE0QBMXV8RSS3RSRQ | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |   1.00 | 2026-10-29 21:38:27.516756+00 | 2026-10-25 12:45:54.123+00 | 
 pglt_01M64SK6HXEET9BRBS65X6161H | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |   2.00 | 2026-10-29 21:38:27.516756+00 | 2026-10-25 12:45:54.123+00 | 
(2 rows)

-- Each transfer created in the batch gets a row in
-- pgledger_idempotency_keys_view with the request_index set uniquely:
SELECT * FROM pgledger_idempotency_keys_view
WHERE idempotency_key = :'idempotency_key' || '-batch';
              idempotency_key               | request_index |           transfer_id           
--------------------------------------------+---------------+---------------------------------
 7a1119e6-4f03-4643-a14e-2b086ff800df-batch |             1 | pglt_01M64SK6HXE0QBMXV8RSS3RSRQ
 7a1119e6-4f03-4643-a14e-2b086ff800df-batch |             2 | pglt_01M64SK6HXEET9BRBS65X6161H
(2 rows)

-- The same batch of transfer requests, but in a different order, is rejected:
SELECT * FROM pgledger_create_transfers(
    event_at => '2026-10-25T12:45:54.123Z',
    idempotency_key => :'idempotency_key' || '-batch',
    transfer_requests => ARRAY[
        (:'account1_id', :'account2_id', '2.00'),
        (:'account1_id', :'account2_id', '1.00')
    ]::TRANSFER_REQUEST[]
);
ERROR:  Idempotency key (7a1119e6-4f03-4643-a14e-2b086ff800df-batch) was already used with a different request
CONTEXT:  PL/pgSQL function pgledger_create_transfers(transfer_request[],timestamp with time zone,jsonb,text) line 55 at RAISE
-- A missing, null, or unique idempotency_key always creates a new transfer
SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    11.00
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |           event_at            | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+-------------------------------+----------
 pglt_01M64SK6HYFGW9BKQC00QRBFQH | pgla_01M64SK6HRE25TEA0YS78FDM8Q | pgla_01M64SK6HRFQM9Y0J4WMXAMYW5 |  11.00 | 2026-10-29 21:38:27.518562+00 | 2026-10-29 21:38:27.518562+00 | 
(1 row)

SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    12.00,
    idempotency_key => NULL
