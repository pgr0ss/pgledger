-- A missing or unique idempotency_key always creates a new transfer
SELECT * FROM pgledger_create_transfer(
    :'account1_id',
    :'account2_id',
    11.00,
    metadata => '{}'
);
               id                |         from_account_id         |          to_account_id          | amount |          created_at           |           event_at            | metadata 
---------------------------------+---------------------------------+---------------------------------+--------+-------------------------------+-------------------------------+----------
